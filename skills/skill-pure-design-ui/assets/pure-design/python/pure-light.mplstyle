# pure, modo claro
# Uso sem instalar o pacote:
#   plt.style.use("caminho/para/pure-light.mplstyle")
# O pacote pure.mpl faz o mesmo e ainda registra os colormaps
# e o acabamento de eixo (pure.mpl.finish).

figure.facecolor: f4f6f9
figure.edgecolor: f4f6f9
figure.dpi: 120
figure.constrained_layout.use: True

savefig.facecolor: f4f6f9
savefig.edgecolor: f4f6f9
savefig.dpi: 300
savefig.bbox: tight
savefig.transparent: False

axes.facecolor: f4f6f9
axes.edgecolor: ced3dc
axes.linewidth: 1.0
axes.labelcolor: 3e5c76
axes.titlecolor: 0d1321
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.spines.bottom: True
axes.titlelocation: left
axes.titlesize: 13
axes.titlepad: 14
axes.labelsize: 10
axes.labelpad: 8
axes.prop_cycle: cycler('color', ['3973b1', '9f8322', '9e527f', '4c985f', '745ba5', 'ba6f3e', '1990ad', 'ac5551'])

grid.color: ced3dc
grid.linewidth: 0.8
grid.alpha: 0.7

xtick.color: 3e5c76
ytick.color: 3e5c76
xtick.labelcolor: 3e5c76
ytick.labelcolor: 3e5c76
xtick.labelsize: 9
ytick.labelsize: 9
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 0
xtick.major.width: 1.0
xtick.minor.visible: False
ytick.minor.visible: False

lines.linewidth: 2.0
lines.markersize: 5.0
lines.solid_capstyle: round

patch.linewidth: 0.0
patch.edgecolor: f4f6f9
patch.force_edgecolor: False

legend.frameon: False
legend.fontsize: 9
legend.handlelength: 1.2
legend.handleheight: 1.2
legend.borderpad: 0.0
legend.columnspacing: 1.4
legend.labelspacing: 0.5

font.family: sans-serif
font.sans-serif: Public Sans, Helvetica Neue, Arial, DejaVu Sans
font.size: 10

text.color: 0d1321
